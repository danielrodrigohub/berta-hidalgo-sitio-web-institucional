{
  "git_path": "/src/content/noticias/",
  "file_extension": ".md",
  "filename_pattern": "",
  "collection_type": "flat",
  "frontmatter_schema": [
    {
      "name": "title",
      "type": "title",
      "label": "Title"
    },
    {
      "name": "description",
      "type": "richtext",
      "label": "Description"
    },
    {
      "name": "date",
      "type": "datetime",
      "label": "Date"
    },
    {
      "name": "category",
      "type": "text",
      "label": "Category"
    },
    {
      "name": "image",
      "type": "image",
      "label": "Image"
    },
    {
      "name": "imageAlt",
      "type": "text",
      "label": "Image Alt"
    },
    {
      "name": "draft",
      "type": "boolean",
      "label": "Draft",
      "default": false
    }
  ]
}
