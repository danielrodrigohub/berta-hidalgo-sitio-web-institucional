---
import '../styles/global.css';
const {title,description='Escuela Berta Hidalgo Barahona de Tahuinco, Salamanca. Educación de NT1 a 8.º básico, proyecto educativo, noticias y documentos para las familias.',image='/images/comunidad-tahuinco.jpg'}=Astro.props;
const institution='Escuela Básica Berta Hidalgo Barahona';
const pageTitle=Astro.props.fullTitle || `${title} | ${institution}`;
const socialImage=new URL(Astro.props.socialImage||image,Astro.site).href;
const socialAlt=Astro.props.socialImageAlt||title;
const canonical=new URL(Astro.url.pathname,Astro.site);
const schema={"@context":"https://schema.org","@type":"School",name:institution,url:Astro.site?.href,logo:new URL('/images/escudo.png',Astro.site).href,telephone:'+56999685889',email:'direccion.bhidalgob.tahuinco@gmail.com',identifier:'RBD 1017',address:{'@type':'PostalAddress',streetAddress:'Camino Público, kilómetro 16, Tahuinco',addressLocality:'Salamanca',addressRegion:'Coquimbo',addressCountry:'CL'}};
---
<!doctype html><html lang="es-CL"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{pageTitle}</title><meta name="description" content={description}/>{Astro.props.noindex&&<meta name="robots" content="noindex, nofollow"/>}<link rel="canonical" href={canonical}/><link rel="icon" type="image/png" href="/images/escudo.png"/><meta property="og:title" content={pageTitle}/><meta property="og:description" content={description}/><meta property="og:type" content={Astro.props.article?'article':'website'}/><meta property="og:url" content={canonical}/><meta property="og:site_name" content={institution}/><meta property="og:image" content={socialImage}/><meta property="og:image:secure_url" content={socialImage}/><meta property="og:image:alt" content={socialAlt}/>{Astro.props.socialImage&&<><meta property="og:image:type" content="image/jpeg"/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/></>}<meta property="og:locale" content="es_CL"/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={pageTitle}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={socialImage}/><meta name="twitter:image:alt" content={socialAlt}/><script type="application/ld+json" set:html={JSON.stringify(schema)}/></head><body><a class="skip" href="#contenido">Ir al contenido</a><div class="topbar"><div class="wrap"><span>Tahuinco · Salamanca</span><div class="utility-links"><a href="/documentos/">Información para familias</a><a href="/contacto/">Cómo llegar</a></div></div></div><header><div class="wrap nav"><a class="brand" href="/" aria-label="Escuela Básica Berta Hidalgo Barahona, inicio"><img src="/images/escudo.png" alt="Escudo de la escuela" width="76" height="76"/><span>Escuela Básica Berta Hidalgo Barahona<small>TAHUINCO · SALAMANCA</small></span></a><button class="menu" aria-expanded="false" aria-controls="navegacion">Menú ☰</button><nav id="navegacion" aria-label="Principal">{[['/escuela/','Nuestra escuela'],['/proyecto-educativo/','Proyecto educativo'],['/noticias/','Vida escolar'],['/documentos/','Documentos'],['/contacto/','Admisión y contacto']].map(([href,label])=><a href={href} aria-current={Astro.url.pathname.startsWith(href)?'page':undefined}>{label}</a>)}</nav></div></header><main id="contenido"><slot/></main><footer><div class="wrap footer-grid"><div><a class="brand light" href="/"><img src="/images/escudo.png" alt="Escudo de la escuela" width="60" height="60"/><span>Escuela Básica Berta Hidalgo Barahona<small>TAHUINCO · SALAMANCA</small></span></a><p>Una escuela que crece junto a su comunidad.</p><p>Educación parvularia y básica · RBD 1017</p></div><div><h2>La escuela</h2><a href="/escuela/">Nuestra escuela</a><a href="/proyecto-educativo/">Proyecto educativo</a><a href="/noticias/">Vida escolar</a><a href="/noticias/">Noticias</a></div><div><h2>Para las familias</h2><a href="/contacto/">Admisión y matrícula</a><a href="/documentos/">Documentos escolares</a><a href="/privacidad/">Privacidad</a><a href="https://mi.mineduc.cl/mvc/mime/ficha?rbd=1017" target="_blank" rel="noopener noreferrer">Ficha MINEDUC ↗</a></div><div><h2>Contacto</h2><p>Camino Público, kilómetro 16<br/>Tahuinco, Salamanca</p><a href="tel:+56999685889">+56 9 9968 5889</a><a class="email" href="mailto:direccion.bhidalgob.tahuinco@gmail.com">direccion.bhidalgob.tahuinco@gmail.com</a></div></div><div class="wrap copyright">© {new Date().getFullYear()} Escuela Berta Hidalgo Barahona<span>Tahuinco, nuestra identidad.</span></div></footer><script>const button=document.querySelector('.menu');const nav=document.querySelector('nav');button?.addEventListener('click',()=>{const open=button.getAttribute('aria-expanded')!=='true';button.setAttribute('aria-expanded',String(open));nav?.classList.toggle('open',open);});document.addEventListener('keydown',(event)=>{if(event.key==='Escape'&&button?.getAttribute('aria-expanded')==='true'){button.setAttribute('aria-expanded','false');nav?.classList.remove('open');(button as HTMLButtonElement).focus();}});nav?.addEventListener('click',(event)=>{if((event.target as HTMLElement).closest('a')){button?.setAttribute('aria-expanded','false');nav.classList.remove('open');}});</script></body></html>
