const canonical=new URL(Astro.url.pathname,Astro.site);
const schema={"@context":"https://schema.org","@type":"School",name:'Escuela Berta Hidalgo Barahona',url:Astro.site?.href,logo:new URL('/images/escudo.png',Astro.site).href,telephone:'+56999685889',email:'direccion.bhidalgob.tahuinco@gmail.com',identifier:'RBD 1017',address:{'@type':'PostalAddress',streetAddress:'Camino Público, kilómetro 16, Tahuinco',addressLocality:'Salamanca',addressRegion:'Coquimbo',addressCountry:'CL'}};
---
<!doctype html><html lang="es-CL"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title} | Escuela Berta Hidalgo Barahona</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="icon" type="image/png" href="/images/escudo.png"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content={Astro.props.article?'article':'website'}/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL(image,Astro.site)}/><meta property="og:locale" content="es_CL"/><meta name="twitter:card" content="summary_large_image"/><script type="application/ld+json" set:html={JSON.stringify(schema)}/></head><body><a class="skip" href="#contenido">Ir al contenido</a><div class="topbar"><div class="wrap"><span>TAHUINCO · SALAMANCA · REGIÓN DE COQUIMBO</span><a href="/documentos/">Documentos para las familias ↗</a></div></div><header><div class="wrap nav"><a class="brand" href="/" aria-label="Escuela Berta Hidalgo Barahona, inicio"><img src="/images/escudo.png" alt="Escudo de la escuela" width="76" height="76"/><span>Berta Hidalgo Barahona<small>ESCUELA · TAHUINCO</small></span></a><button class="menu" aria-expanded="false" aria-controls="navegacion">Menú ☰</button><nav id="navegacion" aria-label="Principal">{[['/escuela/','Nuestra escuela'],['/proyecto-educativo/','Proyecto educativo'],['/noticias/','Noticias'],['/documentos/','Documentos'],['/contacto/','Contacto']].map(([href,label])=><a href={href} aria-current={Astro.url.pathname===href?'page':undefined}>{label}</a>)}</nav></div></header><main id="contenido"><slot/></main><footer><div class="wrap footer-grid"><div><a class="brand light" href="/"><img src="/images/escudo.png" alt="" width="90" height="90"/><span>Berta Hidalgo<small>BARAHONA · TAHUINCO</small></span></a><p>Una escuela que crece junto a su comunidad.</p><p>Educación parvularia y básica · RBD 1017</p></div><div><h2>Encuéntranos</h2><p>Camino Público, kilómetro 16<br/>Tahuinco, Salamanca<br/>Región de Coquimbo, Chile</p><a href="tel:+56999685889">+56 9 9968 5889</a><a class="email" href="mailto:direccion.bhidalgob.tahuinco@gmail.com">direccion.bhidalgob.tahuinco@gmail.com</a></div><div><h2>Comunidad educativa</h2><a href="/documentos/">Proyecto educativo y reglamentos</a><a href="/contacto/">Admisión y consultas</a><a href="https://mi.mineduc.cl/mvc/mime/ficha?rbd=1017" target="_blank" rel="noopener noreferrer">Ficha MINEDUC ↗</a><a href="/privacidad/">Privacidad</a></div></div><div class="wrap copyright">© {new Date().getFullYear()} Escuela Berta Hidalgo Barahona <span>Tahuinco, nuestra identidad.</span></div></footer><script>const button=document.querySelector('.menu');const nav=document.querySelector('nav');button?.addEventListener('click',()=>{const open=button.getAttribute('aria-expanded')!=='true';button.setAttribute('aria-expanded',String(open));nav?.classList.toggle('open',open);});</script></body></html>
