---
import Base from '../../layouts/Base.astro';import {coverInfo} from '../../lib/social.mjs';import Icon from '../../components/Icon.astro';import {getCollection,render} from 'astro:content';
export async function getStaticPaths(){return (await getCollection('noticias',({data})=>!data.draft)).map(post=>({params:{id:post.id},props:{post}}));}
const {post}=Astro.props;const social=coverInfo(post.id,post.data);const {Content}=await render(post);
const related=(await getCollection('noticias',({data})=>!data.draft)).filter(p=>p.id!==post.id).slice(0,1);
const source=post.id==='sala-enlaces'?{name:'David Noticias',url:'https://www.davidnoticias.cl/escuela-de-tahuinco-suma-modernos-computadores-gracias-a-iniciativa-impulsada-junto-a-minera-los-pelambres-y-la-junta-de-vecinos/',caption:'Equipamiento para el aprendizaje en la sala de Enlaces.'}:post.id==='patio-parvulos'?{name:'El Salamanquino',url:'https://www.elsalamanquino.cl/2023/08/11/minera-los-pelambres-y-vecinos-de-tahuinco-concretan-un-nuevo-hito-en-beneficio-de-estudiantes/',caption:'Patio de educación parvularia de la escuela de Tahuinco.'}:null;
const schema={'@context':'https://schema.org','@type':'NewsArticle',headline:post.data.title,description:post.data.description,datePublished:post.data.date.toISOString(),image:post.data.image?new URL(post.data.image,Astro.site).href:undefined,publisher:{'@type':'Organization',name:'Escuela Berta Hidalgo Barahona'}};
---
<Base title={post.data.title} description={post.data.description} image={post.data.image} socialImage={social.url} socialImageAlt={post.data.title+" — Escuela Básica Berta Hidalgo Barahona"} article><div class="interior"><script type="application/ld+json" set:html={JSON.stringify(schema)}/><article class="news-story"><div class="wrap"><div class="breadcrumbs story-breadcrumbs"><a href="/">Inicio</a> / <a href="/noticias/">Noticias</a> / {post.data.category}</div><div class:list={['story-cover',{'story-cover-no-image':!post.data.image}]}>{post.data.image&&<img class="story-cover-image" src={post.data.image} alt={post.data.imageAlt||''} width="1920" height="1249" fetchpriority="high"/>}<div class="story-cover-text"><span class="eyebrow">{post.data.category}</span><h1>{post.data.title}</h1><time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('es-CL',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'})}</time></div></div>{source&&<div class="story-photo-credit"><span>{source.caption}</span><span>Fotografía: {source.name}.</span></div>}</div><div class="story-reading"><p class="story-lead">{post.data.description}</p><div class="article-body"><Content/></div>{source&&<aside class="article-source"><Icon name="document" size={32}/><div><p>Información y fotografía: {source.name}.</p><a class="line-link" href={source.url} target="_blank" rel="noopener noreferrer">Consultar fuente original ↗</a></div></aside>}<a class="line-link back-news" href="/noticias/">← Volver a noticias</a></div></article>{related.length>0&&<section class="tint"><div class="wrap inner-section"><span class="eyebrow">También en nuestra comunidad</span>{related.map(p=><div class="related-article">{p.data.image&&<img src={p.data.image} alt={p.data.imageAlt||''} width="1000" height="600" loading="lazy"/>}<div><span class="meta">{p.data.date.toLocaleDateString('es-CL',{day:'2-digit',month:'short',year:'numeric',timeZone:'UTC'})}</span><h2>{p.data.title}</h2><p>{p.data.description}</p><a class="line-link" href={'/noticias/'+p.id+'/'}>Leer noticia →</a></div></div>)}</div></section>}</div></Base>
