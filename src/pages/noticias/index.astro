---
import Base from '../../layouts/Base.astro';import Intro from '../../components/PageIntro.astro';import Icon from '../../components/Icon.astro';import Callout from '../../components/Callout.astro';import {getCollection} from 'astro:content';
const posts=(await getCollection('noticias',({data})=>!data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
const featured=posts[0];
---
<Base title="Noticias de nuestra escuela"><div class="interior"><Intro title="Noticias de nuestra escuela" breadcrumb="Vida escolar / Noticias" eyebrow="Vida en comunidad" description="Actividades, proyectos e información de la comunidad educativa de Tahuinco."/><section class="wrap news-archive">{featured&&<div class="featured-news">{featured.data.image&&<a href={'/noticias/'+featured.id+'/'}><img src={featured.data.image} alt={featured.data.imageAlt||''} width="1000" height="650" fetchpriority="high"/></a>}<div><span class="meta">{featured.data.category} · {featured.data.date.toLocaleDateString('es-CL',{day:'2-digit',month:'short',year:'numeric',timeZone:'UTC'})}</span><h2>{featured.data.title}</h2><p>{featured.data.description}</p><a class="button" href={'/noticias/'+featured.id+'/'}>Leer noticia →</a></div></div>}{posts.length>1&&<><h2 class="archive-heading">Más de nuestra comunidad</h2>{posts.slice(1).map(post=><div class="archive-row">{post.data.image&&<a href={'/noticias/'+post.id+'/'}><img src={post.data.image} alt={post.data.imageAlt||''} width="1000" height="600" loading="lazy"/></a>}<div><span class="meta">{post.data.category} · {post.data.date.toLocaleDateString('es-CL',{day:'2-digit',month:'short',year:'numeric',timeZone:'UTC'})}</span><h2>{post.data.title}</h2><p>{post.data.description}</p><a class="line-link" href={'/noticias/'+post.id+'/'}>Leer noticia →</a></div></div>)}</>}<p class="archive-note">Archivo de publicaciones · Las fechas corresponden a cada noticia.</p></section><section class="tint"><div class="wrap inner-section"><h2>Conoce más de nuestra escuela.</h2><div class="inner-two related-links"><a href="/proyecto-educativo/"><Icon name="book" size={55}/><div><h3>Nuestro proyecto educativo</h3><p>Conoce nuestra propuesta, principios y enfoque de trabajo.</p><span class="line-link">Nuestro proyecto educativo →</span></div></a><a href="/documentos/"><Icon name="people" size={55}/><div><h3>Información para las familias</h3><p>Revisa documentos y reglamentos para la vida escolar.</p><span class="line-link">Información para las familias →</span></div></a></div></div></section><Callout title="La escuela se vive junto a las familias." text="Te invitamos a conocer más sobre nuestra comunidad educativa."/></div></Base>
