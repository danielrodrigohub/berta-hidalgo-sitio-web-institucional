---
import Base from '../../layouts/Base.astro';
import {getCollection} from 'astro:content';
const posts=(await getCollection('noticias',({data})=>!data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
---
<Base title="Noticias y vida escolar"><section class="page-title"><div class="wrap"><div class="breadcrumbs"><a href="/">Inicio</a> / Noticias</div><span class="eyebrow">Vida en comunidad</span><h1>Lo que nos reúne.</h1><p>Noticias, información y proyectos de la Escuela Berta Hidalgo Barahona de Tahuinco.</p></div></section><section class="wrap section news-grid">{posts.map(post=><a class="news-card" href={'/noticias/'+post.id+'/'}>{post.data.image&&<img src={post.data.image} alt={post.data.imageAlt||''} loading="lazy"/>}<span class="meta">{post.data.category} · {post.data.date.toLocaleDateString('es-CL',{timeZone:'UTC'})}</span><h2>{post.data.title}</h2><p>{post.data.description}</p><span class="line-link">Leer noticia →</span></a>)}</section></Base>
