---
import Base from '../layouts/Base.astro';import Intro from '../components/PageIntro.astro';import Icon from '../components/Icon.astro';import Callout from '../components/Callout.astro';
const docs=[['proyecto-educativo','Proyecto Educativo Institucional','PEI 2025 · Identidad, misión, visión y propuesta formativa.'],['reglamento-convivencia','Reglamento Interno de Convivencia Escolar','Acuerdos, protocolos y vida en comunidad.'],['reglamento-evaluacion','Reglamento de Evaluación','Evaluación y promoción escolar.']];
---
<Base title="Documentos institucionales"><div class="interior"><Intro title="Documentos institucionales" breadcrumb="Documentos" eyebrow="Información para las familias" description="Consulta el proyecto educativo y los reglamentos de nuestra escuela."/><section class="tint"><div class="wrap inner-section icon-row"><Icon name="document" size={60}/><div><h2>Archivos en PDF</h2><p>Abre cada documento para consultar su contenido y versión.</p></div></div></section><section class="wrap documents-list">{docs.map(([file,title,desc])=><div class="pdf-row"><Icon name="document" size={60}/><div><h2>{title}</h2><p>{desc}</p></div><span class="pdf-label">PDF</span><a class="button" href={'/documentos/'+file+'.pdf'} target="_blank" rel="noopener" aria-label={title+', abrir PDF en nueva pestaña'}>Abrir PDF ↗</a></div>)}</section><section class="tint"><div class="wrap inner-section"><h2>¿Qué documento necesitas?</h2><p>Te orientamos para que encuentres el documento adecuado según tu interés.</p><div class="document-guide">{[['book','Conocer la propuesta de la escuela','El Proyecto Educativo Institucional presenta la identidad, misión, visión y propuesta formativa.'],['people','Consultar acuerdos y convivencia','El Reglamento Interno de Convivencia Escolar reúne acuerdos, protocolos y orientaciones para la vida escolar.'],['document','Entender evaluación y promoción','El Reglamento de Evaluación explica cómo se realiza la evaluación y promoción escolar.']].map(([icon,title,text])=><div><Icon name={icon} size={55}/><h3>{title}</h3><p>{text}</p></div>)}</div></div></section><div class="wrap inner-section"><p class="version-note">Consulta el año y la versión que figuran en cada archivo. Para confirmar actualizaciones, comunícate con la dirección.</p></div><Callout title="¿Necesitas orientación?" text="Consulta a la escuela si no encuentras el documento que buscas." label="Contactar a la escuela"/></div></Base>
