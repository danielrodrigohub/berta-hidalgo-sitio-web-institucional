---
import Base from '../layouts/Base.astro';
import SchoolPhoto from '../components/SchoolPhoto.astro';
import Icon from '../components/Icon.astro';
import {getCollection} from 'astro:content';
const posts=(await getCollection('noticias',({data})=>!data.draft&&data.category!=='Información institucional')).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf()).slice(0,2);
const docs=[['proyecto-educativo','Proyecto Educativo Institucional','Identidad, misión y propuesta formativa.'],['reglamento-convivencia','Reglamento de Convivencia Escolar','Acuerdos, cuidado y vida en comunidad.'],['reglamento-evaluacion','Reglamento de Evaluación','Evaluación y promoción escolar.']];
const maps='https://www.google.com/maps/search/?api=1&query=Escuela+Berta+Hidalgo+Barahona+Tahuinco+Salamanca';
---
<Base title="Escuela rural en Tahuinco, Salamanca"><div class="home">
<section class="home-hero"><div class="home-hero-copy"><span class="eyebrow">Escuela rural · Salamanca</span><h1>Escuela Berta<br/>Hidalgo Barahona</h1><p class="hero-subtitle">Aprender y crecer en nuestra comunidad de Tahuinco.</p><p>Educación parvularia y básica, desde NT1 a 8.º básico, con respeto, identidad y participación.</p><a class="button" href="/escuela/">Conoce nuestra escuela <Icon name="arrow" size={18}/></a><a class="line-link hero-admission" href="/contacto/">Consulta por admisión →</a></div><SchoolPhoto name="fachada-escuela" alt="Entrada de la Escuela Berta Hidalgo Barahona con sus murales y bandera chilena" width={1080} height={810} priority class="homepage-front"/></section>
<section class="quick-band" aria-label="Accesos para las familias"><div class="wrap quick-grid">{[['people','Admisión y matrícula','Información y orientación para familias.','/contacto/'],['document','Documentos escolares','Reglamentos y documentos institucionales.','/documentos/'],['calendar','Noticias y actividades','Conoce nuestra vida en comunidad.','/noticias/'],['pin','Ubicación y contacto','Cómo llegar y datos de la escuela.','#ubicacion']].map(([icon,title,desc,href])=><a href={href}><Icon name={icon}/><h2>{title}</h2><p>{desc}</p></a>)}</div></section>
<section class="wrap home-school"><SchoolPhoto name="actividad-aire-libre" alt="Grupo de estudiantes y un adulto en un entorno de rocas y vegetación" caption="Actividad al aire libre. Fotografía aportada por la comunidad escolar." class="homepage-community"/><div><span class="eyebrow">Nuestra escuela</span><h2>Una escuela que es parte de Tahuinco.</h2><p>Junto al río Choapa, nuestra escuela reúne a niños, niñas y familias en torno al aprendizaje y la vida en comunidad. Valoramos nuestra identidad local y el trabajo conjunto entre la escuela, las familias y el territorio.</p><a class="line-link" href="/escuela/">Nuestra historia y comunidad →</a></div></section>
<section class="home-levels"><div class="wrap"><span class="eyebrow">Niveles educativos</span><h2>Acompañamos cada etapa de aprendizaje.</h2><div class="level-grid"><a class="level" href="/escuela/#educacion-parvularia"><Icon name="children" size={60}/><div><h3>Educación parvularia</h3><p class="level-subtitle">Prekínder y kínder</p><p>Los primeros aprendizajes en un ambiente cercano, donde el juego, la curiosidad y la exploración acompañan el desarrollo de niños y niñas.</p><span class="line-link">Conocer el nivel →</span></div></a><a class="level" href="/escuela/#educacion-basica"><Icon name="book" size={60}/><div><h3>Educación básica</h3><p class="level-subtitle">1.º a 8.º básico</p><p>Una etapa para desarrollar conocimientos, autonomía y habilidades para aprender y convivir con respeto.</p><span class="line-link">Conocer el nivel →</span></div></a></div></div></section>
<section class="wrap home-project"><div class="project-heading"><div><span class="eyebrow">Proyecto educativo</span><h2>Aprender, participar y descubrir.</h2></div><div><p>Nuestro proyecto educativo promueve una formación integral, la convivencia y la participación de la comunidad.</p><a class="button" href="/proyecto-educativo/">Conoce nuestra propuesta <Icon name="arrow" size={18}/></a></div></div><div class="project-content"><SchoolPhoto name="banda-escolar" alt="Integrantes de la banda escolar con instrumentos de viento y percusión en el patio" caption="Banda escolar." class="homepage-band"/><div class="project-rows">{[['laptop','Tecnología y robótica','Enlaces y robótica forman parte de los espacios de apoyo al aprendizaje descritos en el PEI.'],['music','Música y expresión','La música y las expresiones escénicas acompañan la formación integral.'],['ball','Deporte y ajedrez','El PEI incluye talleres deportivos y de ajedrez entre sus oportunidades educativas.']].map(([icon,title,description])=><div class="project-row"><Icon name={icon} size={42}/><div><h3>{title}</h3><p>{description}</p></div></div>)}<p class="source-note">Áreas descritas en el PEI 2025. Consulta la programación actual con la escuela.</p></div></div></section>
<section class="home-news"><div class="wrap"><div class="section-head"><div><span class="eyebrow">Vida en comunidad</span><h2>Noticias de nuestra escuela</h2></div><a class="line-link" href="/noticias/">Todas las noticias →</a></div><div class="home-news-grid">{posts.map(post=><a class="home-news-card" href={'/noticias/'+post.id+'/'}><img src={post.data.image} alt={post.data.imageAlt||''} width="1000" height="600" loading="lazy"/><span class="meta">{post.data.category} · <time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('es-CL',{day:'2-digit',month:'short',year:'numeric',timeZone:'UTC'})}</time></span><h3>{post.data.title}</h3><p>{post.data.description}</p><span class="line-link">Leer noticia →</span></a>)}<a class="home-news-card" href="/proyecto-educativo/"><div class="institutional-visual"><Icon name="document" size={64}/></div><span class="meta">Información institucional</span><h3>Conoce nuestro proyecto educativo</h3><p>Revisa los principios, valores y propuestas formativas de nuestra escuela.</p><span class="line-link">Leer más →</span></a></div></div></section>
<section class="home-documents"><div class="wrap"><div class="section-head"><div><span class="eyebrow">Documentos institucionales</span><h2>Información para las familias.</h2></div><p>Conoce los documentos que orientan<br/>nuestra vida escolar.</p></div><div class="home-doc-list">{docs.map(([file,title,description])=><a class="home-doc" href={'/documentos/'+file+'.pdf'} target="_blank" rel="noopener" aria-label={title+' (PDF, abre en otra pestaña)'}><Icon name="document" size={34}/><div><h3>{title}</h3><p>{description}</p></div><span class="pdf-label">PDF</span><Icon name="arrow" size={22}/></a>)}</div></div></section>
<section class="home-admission"><div class="wrap"><div><h2>Conversemos sobre su próxima etapa escolar.</h2><p>Te invitamos a conocer nuestra escuela y resolver tus dudas sobre el proceso de admisión.</p></div><a class="button" href="/contacto/">Orientación para admisión <Icon name="arrow" size={18}/></a></div></section>
<section class="wrap home-location" id="ubicacion"><div><span class="eyebrow">Contacto y ubicación</span><h2>Estamos en Tahuinco, Salamanca.</h2><p><Icon name="pin" size={22}/><span>Camino Público, kilómetro 16<br/>Tahuinco, Salamanca · Región de Coquimbo</span></p><p><Icon name="phone" size={22}/><a href="tel:+56999685889">+56 9 9968 5889</a></p><p><Icon name="mail" size={22}/><a class="email" href="mailto:direccion.bhidalgob.tahuinco@gmail.com">direccion.bhidalgob.tahuinco@gmail.com</a></p></div><div class="home-directions"><Icon name="pin" size={50}/><h3>Cómo llegar a la escuela</h3><p>Busca por nombre y localidad en Google Maps.</p><a class="line-link" href={maps} target="_blank" rel="noopener noreferrer">Cómo llegar →</a></div></section>
</div></Base>
